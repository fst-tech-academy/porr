{
  "name": "npst",
  "version": "1.0.0",
  "description": "New Project Starter Template - A comprehensive system template for building enterprise applications",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "npst",
    "template",
    "application",
    "react",
    "nodejs",
    "mongodb",
    "typescript"
  ],
  "author": "Local Authority Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.914.0",
    "@aws-sdk/s3-request-presigner": "^3.914.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@tailwindcss/vite": "^4.1.13",
    "bcryptjs": "^3.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1"
  }
}
